# Use the Supabase SESSION pooler string (port 5432). Prepared statements work
# in session mode; they do not in transaction mode (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=<your model name>

# Set to "offline" to use the built-in stand-in model (no LLM calls, no quota).
# HAGGLE_LLM=offline
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# LOG_LEVEL=INFO